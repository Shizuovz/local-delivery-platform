{
  "name": "local-delivery-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace apps/api run start:dev",
    "worker:dispatch": "npm --workspace apps/api run worker:dispatch",
    "dev:admin": "npm --workspace apps/admin-web run dev",
    "dev:business": "npm --workspace apps/business-web run dev",
    "dev:customer": "npm --workspace apps/customer-mobile run start",
    "dev:rider": "npm --workspace apps/rider-mobile run start",
    "worker:payments": "npm --workspace apps/api run worker:payments",
    "db:generate": "npm --workspace packages/database run prisma:generate",
    "db:push": "npm --workspace packages/database run prisma:push",
    "db:seed": "npm --workspace packages/database run prisma:seed",
    "db:reset": "npm --workspace packages/database run prisma:reset",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test": "npm --workspaces --if-present run test",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "lint": "npm --workspaces --if-present run lint"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "@prisma/client": "6.12.0",
    "prisma": "6.12.0",
    "uuid": "^11.1.1"
  }
}
