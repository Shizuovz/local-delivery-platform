{
  "name": "@local-delivery/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "worker:dispatch": "ts-node -r tsconfig-paths/register src/jobs/dispatch.worker.ts",
    "start": "node dist/apps/api/src/main.js",
    "build": "nest build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@aws-sdk/s3-request-presigner": "^3.1124.0",
    "@local-delivery/database": "file:../../packages/database",
    "@local-delivery/types": "file:../../packages/types",
    "@local-delivery/validation": "file:../../packages/validation",
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "bullmq": "^6.3.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/node": "^22.10.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
